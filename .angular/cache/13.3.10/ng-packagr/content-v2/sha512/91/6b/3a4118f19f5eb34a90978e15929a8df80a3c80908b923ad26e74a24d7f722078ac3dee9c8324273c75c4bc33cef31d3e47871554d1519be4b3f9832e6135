ta.dataSource;\r\n  }\r\n\r\n  get displayedColumns(): string[] {\r\n    return ['startDate', 'endDate', ...this.columns.map(x => x.name)];\r\n  }\r\n\r\n  getDate(date: Date): Date {\r\n    return new Date(date);\r\n  }\r\n\r\n  getList(list: any[]): string[] {\r\n    return toArray(list).map(x => x.toString());\r\n  }\r\n}\r\n","<div id=\"audit-history\" class=\"scrollable\">\r\n  <table mat-table [dataSource]=\"dataSource\">\r\n    <!-- Start Date Column -->\r\n    <ng-container matColumnDef=\"startDate\">\r\n      <th mat-header-cell *matHeaderCellDef>Start Date</th>\r\n      <td mat-cell *matCellDef=\"let element\">\r\n        {{ element.startDate | date: 'shortDate' }}\r\n      </td>\r\n      <td mat-footer-cell *matFooterCellDef>\r\n        {{ activeRow?.startDate | date: 'shortDate' }}\r\n      </td>\r\n    </ng-container>\r\n\r\n    <!-- End Date Column -->\r\n    <ng-container matColumnDef=\"endDate\" sticky>\r\n      <th mat-header-cell *matHeaderCellDef>End Date</th>\r\n      <td mat-cell *matCellDef=\"let element\">\r\n        {{ element.endDate | date: 'shortDate' }}\r\n      </td>\r\n      <td class=\"active\" mat-footer-cell *matFooterCellDef>ACTIVE</td>\r\n    </ng-container>\r\n\r\n    <!-- Custom Columns -->\r\n    <ng-container *ngFor=\"let column of columns\" [matColumnDef]=\"column.name\">\r\n      <th mat-header-cell *matHeaderCellDef>{{ column.label }}</th>\r\n      <td mat-cell *matCellDef=\"let element\">\r\n        <span *ngIf=\"!column.type\">{{ element[column.name] }}</span>\r\n        <span *ngIf=\"column.type === 'DATE'\">{{\r\n          getDate(element[column.name]) | date: 'shortDate'\r\n        }}</span>\r\n        <span *ngIf=\"column.type === 'LIST'\">\r\n          <div *ngFor=\"let item of getList(element[column.name])\">\r\n            {{ item }}\r\n          </div>\r\n        </span>\r\n      </td>\r\n      <!--Active Row-->\r\n      <td mat-footer-cell *matFooterCellDef>\r\n        <span *ngIf=\"!column.type\">{{ activeRow[column.name] }}</span>\r\n        <span *ngIf=\"column.type === 'DATE'\">{{\r\n          getDate(activeRow[column.name]) | date: 'shortDate'\r\n        }}</span>\r\n        <span *ngIf=\"column.type === 'LIST'\">\r\n          <div *ngFor=\"let item of getList(activeRow[column.name])\">\r\n            {{ item }}\r\n          </div>\r\n        </span>\r\n      </td>\r\n      <!--End Active Row-->\r\n    </ng-container>\r\n\r\n    <!-- Star Column -->\r\n    <!-- <ng-container matColumnDef=\"star\" stickyEnd>\r\n      <th mat-header-cell *matHeaderCellDef></th>\r\n      <td mat-cell *matCellDef=\"let element\">\r\n        <mat-icon>more_vert</mat-icon>\r\n      </td>\r\n    </ng-container> -->\r\n\r\n    <tr mat-header-row *matHeaderRowDef=\"displayedColumns; sticky: true\"></tr>\r\n    <tr mat-row *matRowDef=\"let row; columns: displayedColumns\"></tr>\r\n    <tr\r\n      class=\"bold\"\r\n      mat-footer-row\r\n      *matFooterRowDef=\"displayedColumns; sticky: true\"\r\n    ></tr>\r\n  </table>\r\n</div>\r\n"]},"resolvedIds":{"@angular/core":{"external":true,"id":"@angular/core","meta":{},"moduleSideEffects":true,"syntheticNamedExports":false},"@angular/material/dialog":{"external":true,"id":"@angular/material/dialog","meta":{},"moduleSideEffects":true,"syntheticNamedExports":false},"@ngrx/store":{"external":true,"id":"@ngrx/store","meta":{},"moduleSideEffects":true,"syntheticNamedExports":false},"@angular/material/table":{"external":true,"id":"@angular/material/table","meta":{},"moduleSideEffects":true,"syntheticNamedExports":false},"@angular/common":{"external":true,"id":"@angular/common","meta":{},"moduleSideEffects":true,"syntheticNamedExports":false},"../../../shared/component":{"external":false,"id":"C:\\Users\\dsalgado.contr\\source\\Workspaces\\CAIU-LIBRARY\\CAIU-LIBRARY\\dist\\library\\esm2020\\lib\\shared\\component.mjs","meta":{},"moduleSideEffects":true,"syntheticNamedExports":false},"../audit.model":{"external":false,"id":"C:\\Users\\dsalgado.contr\\sourc